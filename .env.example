LOG_LEVEL=INFO

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_DATABASE_PATH=./data/gateway.db
GATEWAY_SHARED_TOKEN=change-me

TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_ALLOWED_USER_ID=123456789
# Optional: if omitted, the gateway learns the private chat id from /start.
TELEGRAM_CHAT_ID=
# Optional webhook URL; if unset the gateway uses polling.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

CONNECTOR_GATEWAY_URL=ws://127.0.0.1:8000/ws/connectors
CONNECTOR_GATEWAY_SHARED_TOKEN=change-me
CONNECTOR_WORKDIR=.
CONNECTOR_STATE_DIR=.telegram-acp-connector
CONNECTOR_ALIAS=
CONNECTOR_AGENT_ID=
# Default ACP launch command. The `connector` CLI also accepts a passthrough command.
CONNECTOR_DEFAULT_ACP_COMMAND=agent acp
CONNECTOR_HEARTBEAT_SECONDS=15
